# TruthLens environment configuration
# Copy this file to `.env` and fill in values. Never commit `.env` to git.

# ── Model ──────────────────────────────────────────────────────────────────────
# TRUTHLENS_MODEL_PATH=C:\Users\Shravani\TruthLens\models\best_truthlens_v4.pth

# ── Logging ───────────────────────────────────────────────────────────────────
TRUTHLENS_LOG_LEVEL=INFO
TRUTHLENS_LOG_CONSOLE=true
TRUTHLENS_AUDIT_LOG=true
# TRUTHLENS_LOG_DIR=C:\Users\Shravani\TruthLens\logs

# ── Security / upload limits ──────────────────────────────────────────────────
TRUTHLENS_MAX_UPLOAD_MB=10
TRUTHLENS_MAX_IMAGE_PIXELS=25000000
TRUTHLENS_ALLOWED_EXTENSIONS=jpg,jpeg,png,bmp,tiff,webp,pdf
TRUTHLENS_MAX_PDF_PAGES=10
TRUTHLENS_API_KEY=
TRUTHLENS_DATA_DIR=
TRUTHLENS_RETENTION_DAYS=7

# ── Verdict thresholds ────────────────────────────────────────────────────────
TRUTHLENS_THRESHOLD_FAKE=0.85
TRUTHLENS_THRESHOLD_REAL=0.60

# ── Future gov API credentials (add when you get sandbox access) ──────────────
# SETU_CLIENT_ID=
# SETU_CLIENT_SECRET=
# SETU_ENV=sandbox
